{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "rootDir": "./webapp",
    "types": [],
    "paths": {
      "com/imported/neptune_flight/*": [
        "./webapp/*"
      ]
    }
  },
  "include": [
    "./webapp/**/*"
  ]
}
